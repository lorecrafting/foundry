#!/usr/bin/env bash
# foundry — CLI wrapper for the Foundry manual lane.
#
# Sends argv, encoded as inert data, to the running lane daemon via the release binary's
# `rpc`, so lane commands execute in the daemon's BEAM (docs/batch-d/LANE-RUNBOOK.md).
# The daemon dispatches only `lane` commands; every other argv is refused there.
#
# Works from both the main repo and worktrees.
#
# Usage:
#   foundry lane status [TICKET] [--json]
#   foundry lane admit|packet|submit|review|settle|log|integrated|recover ...

set -euo pipefail

# ── Resolve release binary path ──

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FOUNDRY_DIR="$(dirname "$SCRIPT_DIR")"

# `lane` commands go to the lane daemon that bin/foundry-lane starts (its own release and
# node name), never to a legacy daemon. Explicit FOUNDRY_RELEASE and RELEASE_NODE still win.
if [ "${1:-}" = "lane" ]; then
  eval "$("$SCRIPT_DIR/foundry-lane" env)"
fi

# 1. Try relative to script (main repo case)
RELEASE_BIN="$FOUNDRY_DIR/_build/prod/rel/foundry/bin/foundry"

# 2. Try env var override. An explicit but invalid override is an error; silently
# falling back could send a command to a different daemon than the caller chose.
if [ -n "${FOUNDRY_RELEASE:-}" ]; then
  if [ ! -x "$FOUNDRY_RELEASE" ]; then
    echo "Error: FOUNDRY_RELEASE is not executable: $FOUNDRY_RELEASE" >&2
    exit 69
  fi

  RELEASE_BIN="$FOUNDRY_RELEASE"
fi

# 3. Worktree detection via .git file
if [ ! -x "$RELEASE_BIN" ]; then
  GIT_FILE="$FOUNDRY_DIR/.git"
  if [ -f "$GIT_FILE" ]; then
    GITDIR_LINE=$(head -1 "$GIT_FILE" 2>/dev/null || echo "")
    case "$GITDIR_LINE" in
      gitdir:*)
        MAIN_DIR="${GITDIR_LINE#gitdir: }"
        MAIN_DIR="${MAIN_DIR%/.git*}"
        RELEASE_BIN="$MAIN_DIR/_build/prod/rel/foundry/bin/foundry"
        ;;
    esac
  fi
fi

# 4. Last resort: common user paths
if [ ! -x "$RELEASE_BIN" ]; then
  for candidate in \
    "$HOME/dev/foundry/_build/prod/rel/foundry/bin/foundry" \
    "$HOME/foundry/_build/prod/rel/foundry/bin/foundry"; do
    if [ -x "$candidate" ]; then
      RELEASE_BIN="$candidate"
      break
    fi
  done
fi

if [ ! -x "$RELEASE_BIN" ]; then
  echo "Error: cannot find foundry release binary" >&2
  echo "" >&2
  echo "The release binary is at _build/prod/rel/foundry/bin/foundry" >&2
  echo "Build it from the root of the main checkout:" >&2
  echo "  MIX_ENV=prod mix release" >&2
  echo "" >&2
  echo "Or set FOUNDRY_RELEASE env var:" >&2
  echo "  export FOUNDRY_RELEASE=/path/to/foundry/_build/prod/rel/foundry/bin/foundry" >&2
  exit 1
fi

# ── Encode arguments as inert data for the fixed RPC entry point ──

# The decoded JSON envelope is capped at 64 KiB. Its unpadded URL-safe Base64
# representation stays below 88 KiB, leaving margin under common per-argument
# operating-system limits. The encoded alphabet cannot terminate the Elixir string
# or introduce interpolation; the daemon independently validates canonical encoding.
encode_for_rpc() {
  elixir -e '
try do
  raw =
    %{"version" => 1, "argv" => System.argv()}
    |> :json.encode()
    |> IO.iodata_to_binary()

  if byte_size(raw) > 65_536 do
    IO.puts(:stderr, "Error: RPC argument payload exceeds 65536 bytes")
    System.halt(64)
  end

  IO.write(Base.url_encode64(raw, padding: false))
rescue
  error ->
    IO.puts(:stderr, "Error: could not encode RPC arguments: #{Exception.message(error)}")
    System.halt(65)
end
' -- "$@"
}

if PAYLOAD=$(encode_for_rpc "$@"); then
  RPC_CODE="Foundry.CLI.RPC.run(\"${PAYLOAD}\")"
else
  ENCODE_STATUS=$?
  exit "$ENCODE_STATUS"
fi

# ── Execute on daemon node via RPC ──

# Preserve the release command's stdout, stderr and exact status. A nonzero result
# may be a command rejection rather than a connection failure, so do not relabel it.
if "$RELEASE_BIN" rpc "$RPC_CODE"; then
  exit 0
else
  exit $?
fi
